# Copy to .env (or pull the dev values: bunx vercel env pull .env.local --environment=preview --git-branch=dev).
# Bun loads .env and .env.local automatically.

# Postgres the app connects to. Locally, the docker-compose one: postgres://excuses:excuses@localhost:5432/excuses
DATABASE_URL=
# Direct (unpooled) connection, used for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Random secret that signs and encrypts sessions (bunx auth secret, or openssl rand -base64 33).
AUTH_SECRET=
# Google OAuth client. Its redirect URI is <origin>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public origin of the app when it differs from the request's host. Leave empty locally.
AUTH_URL=
# Auth.js endpoint of the dev deployment that completes Google sign-in for previews (and locally, if set).
AUTH_REDIRECT_PROXY_URL=

# Bucket for proof photos, and its region.
S3_BUCKET=
S3_REGION=
# Prefix for every object key (empty in production, dev/ in dev, preview/pr-<n>/ in previews).
S3_PREFIX=
# IAM role the Vercel function assumes with its OIDC token. Locally, leave empty to use your AWS credentials.
S3_ROLE_ARN=
# S3-compatible endpoint and its keys, for local storage. With docker-compose: http://localhost:8333, excuses, excuses-local.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Port of the local server (default 3000).
PORT=
# Postgres the end-to-end API tests create throwaway schemas in (bun run test:full sets it when using Docker).
TEST_DATABASE_URL=
