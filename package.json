{
  "name": "excuses-excuses-excuses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit && bun test",
    "test:full": "bun scripts/test-full.ts",
    "db:migrate:deploy": "bun scripts/migrate.ts",
    "build:vercel": "bun run build && bun scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.21",
    "pg": "^8.23.1"
  }
}
